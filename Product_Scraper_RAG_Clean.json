      "parameters": {
        "jsCode": "// Step 1: Pichney node se URLs ki list uthayen\nconst urls = items[0].json[\"subpages-urls\"] || [];\n\n// Step 2: Sirf wo links rakhein jo products wali hain\n// Agar apko yaqeen hai k sary links theek hain to .filter hata sakty hain\nconst productUrls = urls.filter(url => url.includes('/products/'));\n\n// Step 3: Har URL ko aik alag item bana kar agay bhejein\nreturn productUrls.map(url => {\n  return {\n    json: {\n      url: url\n    }\n  };\n});"
